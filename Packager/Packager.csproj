<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds and publishes the releases for each Unity version. Has no package dependencies: it uses Unity's and GitHub's
       APIs through HttpClient and the gh CLI, and reads the files from Unity's module packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Lustral.UnityLibraries</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Packager.Tests" />
  </ItemGroup>

</Project>
