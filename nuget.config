<?xml version="1.0" encoding="utf-8"?>
<!-- nuget.org only: runner images register sources of their own (Visual Studio's offline packages, for one). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
